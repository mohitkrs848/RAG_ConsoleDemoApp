# Visual Studio / .NET common ignore rules

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
**/[Bb]in/
**/[Oo]bj/

# Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.
.vs/
.vscode/
TestResults/
build/
publish/

# NuGet
*.nupkg
# NuGet packages folder
packages/

# Rider
.idea/

# Visual Studio cache files
*.cache

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# dotnet user secrets
secrets.json

# LocalDB / SQL Server files
*.mdf
*.ldf

# sensitive files
*.pfx
*.key

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db

# JetBrains Rider
.idea/

# JetBrains Rider caches
.idea/*/workspace.xml

# Logs and databases
*.sqlite
*.db

# Temporary files
*_ReSharper.*

# Ignore the docs output if any
/Docs/_site/

# Ignore compiled Python files if present
__pycache__/
*.pyc
